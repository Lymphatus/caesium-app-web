{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caesium-app-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  // Disable esbuild's keep-names so the helper it injects (__name) doesn't leak
  // into inline scripts that libraries (e.g. next-themes) serialize via toString().
  // Fixes "Uncaught ReferenceError: __name is not defined". Needs Wrangler >= 4.13.0.
  "keep_names": false,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "beta": {
      "name": "caesium-app-web-beta"
    },
    "production": {
      "name": "caesium-app-web"
    }
  }
}
