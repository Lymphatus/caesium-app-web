# Canonical public origin of the deployed site (no trailing slash).
# Used for metadata (canonical/hreflang/Open Graph), robots.txt, and sitemap.xml.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Maximum number of files accepted in a single batch (default: 10).
NEXT_PUBLIC_FILES_LIMIT=10

# Maximum size per file, in bytes (default: 20000000 = 20 MB).
NEXT_PUBLIC_MAX_FILE_SIZE=20000000

# Caesium API origin for anonymous usage stats. Leave empty to disable (no calls).
NEXT_PUBLIC_API_HOST=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
GTAG_ID=

# Matomo instance endpoint without trailing slash (e.g. https://stats.example.com). Leave empty to disable.
MATOMO_ENDPOINT=
